NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional: server-only key for protected Auth administration routes. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Dev-only: true = vào thẳng /admin không cần đăng nhập (chỉ có tác dụng với npm run dev)
ADMIN_AUTH_BYPASS=false

# Website (public). Điền trước khi ra mắt: dùng cho SEO, sitemap, chân trang, trang Giới thiệu/Liên hệ/Điều khoản.
NEXT_PUBLIC_SITE_URL=https://mexemtruyen.com
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_TAX_CODE=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# Chống spam lượt xem: chuỗi ngẫu nhiên >= 16 ký tự, giữ bí mật (tạo bằng: openssl rand -hex 24)
VIEW_IP_SALT=

# Cloudflare Turnstile (chống bot đăng nhập/đăng ký). Để trống = tắt. Secret key đặt trong Supabase, không đặt ở đây.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional Cloudflare R2 (server-only; never expose secret keys to the browser)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# Tên bucket public (để admin mở thẳng thư mục trong Cloudflare Dashboard)
R2_PUBLIC_BUCKET=
# Host được phép làm link nội dung chương (ngoài host của R2_PUBLIC_URL), cách nhau bằng dấu phẩy. Để trống = chỉ R2.
CHAPTER_TEXT_HOSTS=

# Google AdSense (public, inlined at build time). Ads stay off until ENABLED=true and a valid ca-pub id is set.
# Each placement shows only when its slot id is set, so placements can be turned on one by one.
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADS_PREVIEW=false
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_FEED=
NEXT_PUBLIC_ADSENSE_SLOT_STORY=
NEXT_PUBLIC_ADSENSE_SLOT_CHAPTER_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_CHAPTER_MID=
NEXT_PUBLIC_ADSENSE_SLOT_CHAPTER_END=

# Vercel Cron: chuỗi bí mật ngẫu nhiên; Vercel gửi kèm khi chạy job quét kiểm duyệt hằng đêm (vercel.json).
CRON_SECRET=
