NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional: server-only key for protected Auth administration routes. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Dev-only: true = vào thẳng /admin không cần đăng nhập (chỉ có tác dụng với npm run dev)
ADMIN_AUTH_BYPASS=false

# Optional Cloudflare R2 (server-only; never expose secret keys to the browser)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Google AdSense (public, inlined at build time). Ads stay off until ENABLED=true and a valid ca-pub id is set.
# Each placement shows only when its slot id is set, so placements can be turned on one by one.
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADS_PREVIEW=false
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_FEED=
NEXT_PUBLIC_ADSENSE_SLOT_STORY=
NEXT_PUBLIC_ADSENSE_SLOT_CHAPTER_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_CHAPTER_MID=
NEXT_PUBLIC_ADSENSE_SLOT_CHAPTER_END=
